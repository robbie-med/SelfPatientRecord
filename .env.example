# HealthBinder Environment Configuration
# Copy this file to .env and fill in values

# Server
PORT=3104
NODE_ENV=development
DATA_DIR=./data

# AI Configuration
# Set AI_ENABLED=true to enable AI features (text is sent to remote service)
AI_ENABLED=false
AI_API_KEY=
# For Maple Proxy or OpenAI-compatible endpoints:
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# For production Docker with Maple Proxy:
# AI_BASE_URL=http://localhost:8080/v1
# AI_MODEL=claude-3-5-sonnet-20241022
